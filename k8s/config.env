# Configuración NO sensible compartida por los microservicios (ConfigMap nexus-config).
# El job `deploy` del pipeline reescribe este archivo con las variables del repositorio (vars.*).
# Nunca pongas aquí contraseñas, tokens ni URLs con credenciales: eso va en los Secrets <servicio>-env.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
EVENTS_TOPIC_ARN=
CATALOG_SERVICE_URL=http://catalog
PGSSLMODE=require
DEBUG=false
AUTH_LOCAL_MODE=false
ENABLE_API_DOCS=false
LANGSMITH_TRACING=false
ENABLE_CREWAI_ORCHESTRATION=false
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=*
TRUSTED_PROXY_HOPS=1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SEMCONV_STABILITY_OPT_IN=http
# Guardrails IA (OWASP LLM 2026): kill switch del asistente; false -> 503 sin invocar al modelo.
ASSISTANT_ENABLED=true
ENABLE_LAYA_DECISION_ENGINE=false
