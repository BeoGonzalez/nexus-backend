{
  "title": "Nexus · 0 · Visión general",
  "uid": "nexus-overview",
  "tags": [
    "nexus",
    "owasp",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Nexus Bot (ai-agent-service)",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Tokens por minuto",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "Uso real informado por Groq. Presupuesto: 6.000/min y 150.000/día.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (type) (rate(nexus_llm_tokens_total[$__rate_interval])) * 60 or vector(0)",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos en este rango: ¿está encendido el Learner Lab?"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Respuestas por resultado",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "ok / fallback / timeout / leak_blocked",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (outcome) (rate(nexus_llm_requests_total[$__rate_interval])) * 60 or vector(0)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos en este rango: ¿está encendido el Learner Lab?"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Latencia p95 del asistente",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin solicitudes en este rango: un percentil necesita tráfico (ver guía)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
