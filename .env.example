# ============================================
# Nexus Digital Store — Environment Variables
# ============================================

# Application
APP_NAME=Nexus Digital Store
DEBUG=false

# Database (Amazon Aurora PostgreSQL / asyncpg)
# Local:   postgresql+asyncpg://<usuario>@localhost:5432/nexus  (credenciales solo en tu .env local)
# Aurora:  postgresql+asyncpg://<usuario>@<endpoint-writer-aurora>:5432/<db>  (credenciales en Secrets Manager)
DATABASE_URL=ur-write
DATABASE_READ_URL=url-read
DB_SSL=false
RUN_DB_INIT=true

# Eventos de dominio (Amazon SNS + SQS; en AWS los inyecta nexus-infrastructure/k8s/scripts/deploy.sh)
# Vacios = en local no se publican eventos (solo log) y notifications no consume.
EVENTS_TOPIC_ARN=""
EVENTS_QUEUE_URL=""
AWS_REGION=us-east-1

# AWS Cognito Identity
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq LLM
GROQ_API_KEY=""
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Pinecone Vector Store
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=nexus-catalog
PINECONE_NAMESPACE=catalog

# Wikipedia (Lore & Trivia)
WIKIPEDIA_LANG=es
WIKIPEDIA_TOP_K=1
WIKIPEDIA_MAX_CHARS=2000

# Tavily AI Search (Gaming News & Patches)
TAVILY_API_KEY=""  # gitleaks:allow (vacía: completar solo en .env local)
TAVILY_MAX_RESULTS=3

# CheapShark API (Price Comparison across Steam, Epic, GOG, etc.)
CHEAPSHARK_ENABLED=true
CHEAPSHARK_USD_CLP_RATE=950.0

# Laya AI & CrewAI Orchestration
LAYA_MODEL_NAME=groq/llama-3.1-8b-instant
ENABLE_CREWAI_ORCHESTRATION=false

# LangSmith Observability
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nexus-digital-store
LANGSMITH_TRACING=true

# Embeddings (local HuggingFace)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# RAG
VECTOR_SEARCH_TOP_K=5

# Google Gmail SMTP (Envío de correos desde el LLM con Clave de Aplicación de Google)
# Genera tu clave de 16 caracteres en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""  # Clave de aplicación de Google: solo en .env local
SMTP_FROM_NAME=Nexus Digital Store

